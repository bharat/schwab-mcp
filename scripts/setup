#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# uv (Python package/venv manager — this project's build tool)
python3 -m pip install --user --quiet uv==0.12.6
export PATH="$HOME/.local/bin:$PATH"

# Project deps: dev tools + technical-analysis extras, pinned to uv.lock.
# .venv is a named Docker volume; the mount point is created root-owned, so
# hand it to the current user before uv tries to write into it.
sudo chown "$(id -u):$(id -g)" .venv
uv sync --frozen --group dev --group ta

# pre-commit (installed as a standalone uv tool, not a project dep).
# pre-commit refuses to install if core.hooksPath is set; a bind-mounted
# .git/config often carries an absolute host path here. Clear it at repo scope.
git config --local --unset-all core.hooksPath 2>/dev/null || true
uv tool install pre-commit
pre-commit install

{
  "name": "bharat/schwab-mcp",
  "image": "mcr.microsoft.com/devcontainers/python@sha256:2e0589f0725c951ac8ae0d7169784a9694f5818ec5264ed5231f23c6bf0ab7be",
  "postCreateCommand": "scripts/setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "github.vscode-pull-request-github",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ryanluker.vscode-coverage-gutters",
        "openai.chatgpt",
        "github.vscode-github-actions"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": false,
        "files.trimTrailingWhitespace": true,
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "remoteEnv": {
    "GIT_EDITOR": "cursor --wait",
    "UV_FROZEN": "1"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=schwab-mcp-venv,target=${containerWorkspaceFolder}/.venv,type=volume"
  ],
  "containerEnv": {
    "GIT_AUTHOR_NAME": "Bharat Mediratta",
    "GIT_AUTHOR_EMAIL": "bharat@menalto.com",
    "GIT_COMMITTER_NAME": "Bharat Mediratta",
    "GIT_COMMITTER_EMAIL": "bharat@menalto.com"
  }
}
